{
  "name": "meleiro-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional da Meleiro Tech — websites, landing pages e sistemas personalizados.",
  "homepage": "https://meleiro.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meleiro-sabrina/meleiro-tech.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "esbuild assets/css/main.css assets/css/page.css assets/js/main.js assets/js/page.js --bundle --outdir=assets/dist --outbase=assets --external:/assets/* --format=esm --target=es2020,chrome100,firefox100,safari15 --servedir=. --serve=5173",
    "build": "npm run build:pages && npm run build:assets",
    "build:assets": "esbuild assets/css/main.css assets/css/page.css assets/js/main.js assets/js/page.js --bundle --outdir=assets/dist --outbase=assets --external:/assets/* --format=esm --target=es2020,chrome100,firefox100,safari15 --minify",
    "build:pages": "python3 scripts/build-service-pages.py",
    "format": "npx --yes prettier@3 --write \"assets/**/*.{css,js}\" \"*.{json,md}\"",
    "format:check": "npx --yes prettier@3 --check \"assets/**/*.{css,js}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
